{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.wirecat/whatsapp-cli",
  "title": "WireCat WhatsApp",
  "description": "Your WhatsApp account for agents: read, search and send messages. Sign in with the wa CLI first.",
  "websiteUrl": "https://wirecat.dev/en/docs/wa",
  "repository": {
    "url": "https://github.com/WireCatLabs/whatsapp-cli",
    "source": "github"
  },
  "version": "0.12.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@wirecat/whatsapp-cli",
      "version": "0.12.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--profiles",
          "value": "all",
          "description": "Serve every wa profile on this computer; each tool call names its profile"
        }
      ]
    }
  ]
}
