{
  "name": "@wirecat/whatsapp-cli",
  "version": "0.13.0",
  "description": "A personal WhatsApp account from the terminal, as a linked device — built for agents and scripts",
  "mcpName": "dev.wirecat/whatsapp-cli",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/whatsapp-cli.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.28.8",
  "bin": {
    "wa": "dist/bin/wa.js"
  },
  "files": [
    "dist",
    "skills",
    "install",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build --force && cli-dev bundle --bin dist/bin/wa.js",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:matrix": "vitest run >/dev/null && pnpm build >/dev/null && cli-dev test-matrix --program dist/program.js --untested scripts/test-matrix-untested.ts --name wa --check",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; cli-dev slow-tests",
    "engine:test": "cd engine && unformatted=$(\"$(go env GOROOT)/bin/gofmt\" -l .) && { test -z \"$unformatted\" || { echo \"not gofmt-formatted: $unformatted\" >&2; exit 1; }; } && go vet ./... && go test ./...",
    "bot:spec:sync": "node --experimental-strip-types scripts/bot/sync-spec.ts",
    "bot:generate": "node --experimental-strip-types scripts/bot/generate.ts",
    "bot:generate:check": "node --experimental-strip-types scripts/bot/generate.ts --check",
    "generate": "pnpm build && node --experimental-strip-types scripts/commands.ts",
    "smoke:bun": "bun run scripts/smoke.ts",
    "smoke:node": "node --experimental-strip-types scripts/smoke.ts",
    "release:check": "pnpm build && node --experimental-strip-types scripts/release-check.ts",
    "docs:check": "cli-dev docs-check --rules scripts/release/checks.ts --pages && cspell --no-progress --no-summary README.md 'docs/*.md' && rumdl check --config config/wirecat/rumdl.toml README.md docs/*.md",
    "parity:check": "pnpm build && node dist/bin/wa.js commands --json | cli-core-parity wa && node dist/bin/wa.js commands --json | cli-core-parity wa --pages README.md docs/*.md",
    "version:check": "cli-dev version && node scripts/engine-packages.mjs check",
    "version:sync": "cli-dev version --sync && node scripts/engine-packages.mjs sync",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --log-opts=HEAD --no-banner --redact --exit-code 1 .",
    "prepack": "rm -rf dist tsconfig.tsbuildinfo && pnpm build",
    "postinstall": "node install/postinstall.mjs",
    "check:agent-docs": "pnpm build && node --experimental-strip-types scripts/check-agent-docs.ts",
    "standards:check": "node config/wirecat/check.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md",
    "ci:quick": "pnpm typecheck && pnpm build && pnpm lint:commands",
    "contracts:upgrade": "pnpm --dir contracts/previous install --frozen-lockfile --ignore-scripts && cli-contract contracts/upgrade.json",
    "contracts:check": "cli-contract contracts/plan.json",
    "security:no-leak": "cli-testing security no-leak . contracts/no-leak.json",
    "lint:commands": "cli-dev lint --cli dist/bin/wa.js",
    "engine:build": "cd engine && go build -trimpath -ldflags=\"-s -w\" -o bin/wa-engine ./cmd/wa-engine",
    "engine:packages": "node scripts/engine-packages.mjs build"
  },
  "dependencies": {
    "@wirecat/cli-base": "0.65.0",
    "@wirecat/cli-core": "0.469.0",
    "commander": "15.0.0",
    "valibot": "1.5.0"
  },
  "optionalDependencies": {
    "@wirecat/whatsapp-engine-darwin-arm64": "0.13.0",
    "@wirecat/whatsapp-engine-darwin-x64": "0.13.0",
    "@wirecat/whatsapp-engine-linux-arm64": "0.13.0",
    "@wirecat/whatsapp-engine-linux-x64": "0.13.0",
    "@wirecat/whatsapp-engine-win32-arm64": "0.13.0",
    "@wirecat/whatsapp-engine-win32-x64": "0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cspell/dict-en-gb": "5.0.38",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@wirecat/cli-testing": "0.5.3",
    "cspell": "10.4.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "rumdl": "^0.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
