/.wa/

# Plans, research, rulings and live results: the private repository WireCatLabs/cli-private, linked or cloned here.
/docs_ai
.claude/settings.local.json
.claude/worktrees/
/.worktrees/

# Problem reports from `wa doctor report create`; attached to an issue, never committed.
wa-report-*.json

# What the Bash sandbox lays over these names in the working folder (character devices and empty
# folders, never on disk): without this, `git add -A` inside the sandbox fails on them.
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
