#!/usr/bin/env sh
# Live check for BACKLOG item 9: does a one-shot connection take a queued message that then never reaches the
# store? The owner runs it from a terminal; an agent never does.
#
#   bin/live-oneshot-drop <profile>
#
# It stops the owner's `serve` (by its PID, after checking it is the main checkout's `bin/wa <profile> serve`),
# asks for a message from the phone to the own chat while nothing is connected, runs one `doctor --online` (it
# connects and sends nothing), starts `serve` again exactly so, and counts whether the message reached the store.
# It prints counts and yes/no only: no message text, no id, no number.
set -eu

# shellcheck source-path=SCRIPTDIR source=lib/live.sh
. "$(dirname -- "$0")/lib/live.sh"

profile=${1:-}
need_profile "$profile"
serve_running "$profile" || die "no serve holds profile $profile's device — this check needs one running to stop"
find_serve "$profile" || exit 1

run=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
marker="wacheck$run"
control="wacontrol$run"

# "<found by search> <found among the own chat's newest 50>", "?" for a read that failed.
hits() {
  found=$(wa_json "$profile" search messages "$1" --offline --limit 5 --timeout 30s | json 'd.items.length') ||
    found="?"
  listed=$(wa_json "$profile" messages list me --offline --limit 50 --timeout 30s |
    json 'd.items.filter((one) => (one.text ?? "").includes(a)).length' "$1") || listed="?"
  echo "$found $listed"
}

seen() {
  case "$1" in
    *"?"*) echo unknown ;;
    "0 0") echo no ;;
    *) echo yes ;;
  esac
}

shown() {
  echo "${1% *} by search, ${1#* } among the own chat's newest 50"
}

[ "$(hits "$marker")" = "0 0" ] || die "the store reads failed or already hold the marker — stopping nothing"

stopped=no
started=""
restart() {
  [ "$stopped" = yes ] || return 0
  stopped=no
  if kill -0 "$serve" 2>/dev/null; then
    echo "serve (pid $serve) is still running — not starting a second one" >&2
    return 0
  fi
  start_serve "$profile"
}
finish() {
  restart || true
  [ -n "$started" ] || return 0
  if serve_running "$profile"; then echo "serve holds the lock: yes"; else echo "serve holds the lock: NO" >&2; fi
}
trap finish EXIT
on_signals

cat <<EOF

Plan, on profile $profile:
  1. stop serve (pid $serve, its engine pid $engine) with kill, and wait for the lock to clear
  2. you send yourself a message from the phone containing the word: $marker
  3. one one-shot connection: wa $profile doctor --online (connects, reads the account, sends nothing)
  4. serve starts again as before: $wa $profile serve, detached, output to /dev/null, diagnostics to $serve_err
  5. you send yourself a second message, the control: $control
  6. both words are counted in the store — counts only

While serve is stopped, messages other people send you reach the store only if WhatsApp delivers them again;
that is the question this check answers. Delete the two test messages from the phone afterwards.
EOF
confirm "Step 1 stops serve."

stop_serve "$profile" || exit 1

confirm "Step 2: on the phone, send yourself (Message yourself) a message containing $marker, wait for its tick."

set +e
wa_json "$profile" doctor --online --timeout 60s >/dev/null
code=$?
set -e
echo "doctor --online exited $code"

restart

confirm "Step 5: on the phone, send yourself a message containing $control."
echo "waiting 20 s for serve to save it"
sleep 20

marker_hits=$(hits "$marker")
control_hits=$(hits "$control")
echo
echo "── result ──"
echo "marker, sent while nothing was connected: $(shown "$marker_hits")"
echo "control, sent while serve ran:            $(shown "$control_hits")"
case "$code $(seen "$marker_hits") $(seen "$control_hits")" in
  "0 unknown "* | "0 "*" unknown") echo "No verdict: a store read failed." ;;
  "0 "*" no") echo "No verdict: serve saved not even the control, so it is not saving messages at all." ;;
  "0 no yes") echo "BACKLOG 9 holds: the one-shot connection took the queued message, and it never reached the store." ;;
  "0 yes yes")
    echo "Not dropped this time: the marker reached the store. This does not clear BACKLOG 9:"
    echo "doctor --online may have ended before WhatsApp delivered the queue, and serve then got it."
    ;;
  *) echo "No verdict: doctor --online failed, so the one-shot connection may never have connected." ;;
esac
