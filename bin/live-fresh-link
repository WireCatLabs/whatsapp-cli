#!/usr/bin/env sh
# Live check for BACKLOG item 1, "a fresh session start keeping the history push": links a NEW profile as a
# second linked device of the owner's account and counts what the phone pushes. The owner runs it from a
# terminal; an agent never does.
#
#   bin/live-fresh-link <new-profile>
#   bin/live-fresh-link <profile> --finish
#
# The device keys go to the main checkout's .wa/state, as for any profile there; the pushed history goes to a
# throwaway store, removed at the end, so the owner's shared store is not written. wa draws the QR code in the terminal; the
# result block holds counts only. It leaves the device linked and says how to unlink it.
#
# --finish is for a profile this script linked whose session start ended before the history came: it connects that
# device once, listens with `watch`, and counts what arrived. It needs the profile's device keys, not an account
# record, since a link that ended early may not have saved one; the connection saves it. The messages WhatsApp queued
# for that device land in the throwaway store too, so it is never for a profile in use.
# shellcheck disable=SC2016 # json takes JavaScript, whose ${} is its own
set -eu

# shellcheck source-path=SCRIPTDIR source=lib/live.sh
. "$(dirname -- "$0")/lib/live.sh"

profile=${1:-}
mode=${2:-}
case "$mode" in
  "" | --finish) ;;
  *) die "usage: $(basename -- "$0") <new-profile>, or $(basename -- "$0") <profile> --finish" ;;
esac
known=$(profiles) || die "wa account list failed"
[ -n "$profile" ] || die "name a new profile: $(basename -- "$0") <new-profile> — taken already: ${known:-none}"
has_device() {
  wa_json "$profile" doctor --timeout 30s | json 'd.item.whatsapp.device.exists'
}
if [ "$mode" = --finish ]; then
  [ "$(has_device)" = true ] ||
    die "profile $profile has no device keys — link it with $(basename -- "$0") $profile; logged in: ${known:-none}"
  ! lock_held "$profile" || die "something holds profile $profile's device, serve perhaps — --finish is not for one in use"
  cat <<EOF

This connects profile $profile once and listens for up to 5 minutes, keeping what the phone pushes in a throwaway
store that is removed at the end. Use it only for a profile this script linked: the messages WhatsApp queued for
that device are kept in the throwaway store too, and are gone with it.
EOF
  printf '\nType yes to connect it: '
  read -r answer || exit 130
  [ "$answer" = yes ] || die "nothing connected"
else
  case " $known " in
    *" $profile "*) die "profile $profile exists already — name a new one; taken: $known" ;;
  esac
  device=$(has_device)
  [ "$device" = false ] || die "profile $profile has device keys already — name a new one"

  cat <<EOF

This links a SECOND device to your WhatsApp account, as profile $profile.
WhatsApp shows it under Settings > Linked devices, and the phone pushes your recent history to it once.
Your serve and its device are not touched. The new device stays linked until you unlink it.
EOF
  printf '\nType yes to link it: '
  read -r answer || exit 130
  [ "$answer" = yes ] || die "nothing linked"
fi

store=$(mktemp -d "${TMPDIR:-/tmp}/wa-fresh-link.XXXXXX")
finish() {
  rm -rf -- "$store" || echo "remove the throwaway store yourself: $store" >&2
  [ "$(has_device 2>/dev/null)" != false ] || return 0
  cat <<EOF

Profile $profile is linked as a second device. To unlink it: $wa $profile session end
(it unlinks on WhatsApp's side and deletes its keys here), or on the phone: Settings > Linked devices.
EOF
}
trap finish EXIT
on_signals

# Not bin/wa: in the main checkout it opens the shared store, and the push must land in the throwaway one.
fresh() {
  WA_CONFIG_DIR="$main/.wa/config" WA_STATE_DIR="$main/.wa/state" WA_CACHE_DIR="$main/.wa/cache" \
    MESSAGING_STORE="$store/messages.db" node "$main/dist/bin/wa.js" "$@"
}

if [ "$mode" = --finish ]; then
  cat <<EOF

Keep WhatsApp open on the phone. Ctrl+C ends the wait and keeps what came.
Paste only the result block at the end.
EOF
  trap ':' INT
  set +e
  # watch prints every message it receives; only the counts below leave this script. --jsonl because stdout is not a
  # terminal, and watch refuses the --json that a pipe would get.
  fresh "$profile" watch --jsonl --timeout 5m >/dev/null
  code=$?
  set -e
  on_signals
  ran=watch
else
  cat <<EOF

wa draws the QR code below. Scan it in WhatsApp > Settings > Linked devices > Link a device, then keep WhatsApp
open while the history arrives. Ctrl+C during that wait ends it and keeps what came.
Paste only the result block at the end: the lines above it name your account.
EOF
  # Human mode with the terminal attached is what draws the QR code, as for tg and max. Ctrl+C is wa's to handle here;
  # a trap that does nothing, unlike an ignored signal, is not passed on to node.
  trap ':' INT
  set +e
  fresh "$profile" session start qr --timeout 15m
  code=$?
  set -e
  on_signals
  ran="session start"
fi

echo
echo "── result ──"
echo "$ran exited $code"
# doctor reports a store that was never created without counts: nothing was kept, which "?" used to hide.
fresh "$profile" doctor --json --no-input --timeout 30s 2>/dev/null |
  json 'd.item.store.exists
    ? `history kept: ${d.item.store.chats ?? "?"} chats, ${d.item.store.messages ?? "?"} messages`
    : "history kept: nothing, the throwaway store was never written"' ||
  echo "doctor could not read the throwaway store"
if [ "$code" -ne 0 ] && [ "$mode" != --finish ] && [ "$(has_device 2>/dev/null)" = true ]; then
  echo "the device is linked; to collect the history owed to it: bin/live-fresh-link $profile --finish"
fi
