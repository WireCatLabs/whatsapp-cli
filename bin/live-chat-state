#!/usr/bin/env sh
# Live checks of the chat-state writes (BACKLOG item 5): privacy read back, a mute and an unmute, a message pin and
# an unpin, a star and an unstar (W7), a chat pin, an archive and a mark-unread with their undoing, a delete for the
# owner alone (W6). Each step ends with a question to the owner at the phone.
# The owner runs it from a terminal; an agent never does.
#
#   bin/live-chat-state <profile>
#
# It writes only to the own chat, through the running `serve`, and asks before each write. A step whose command
# this build does not have yet is skipped. It prints exit codes, error codes and yes/no only: no message text, no
# id, no number.
# shellcheck disable=SC2016 # json takes JavaScript, whose ${} is its own
set -eu

# shellcheck source-path=SCRIPTDIR source=lib/live.sh
. "$(dirname -- "$0")/lib/live.sh"

profile=${1:-}
need_profile "$profile"
own=$(own_chat "$profile") || exit 1
serve_running "$profile" ||
  die "start $wa $profile serve first: the writes go through it, so no one-shot connection takes the device"

# Each command path, and each of its options as "<path> --<option>".
paths=$(wa_json "$profile" commands --timeout 30s |
  json 'd.commands.flatMap(function walk(one) {
    const path = one.path.join(" ")
    const options = one.options.map((option) => `${path} ${option.flags.match(/--[a-z-]+/)?.[0]}`)
    return [path, ...options, ...one.commands.flatMap(walk)]
  }).join("\n")') ||
  die "wa commands failed"

run=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
marker="wa state check $run"
errs=$(mktemp)
muted=no
pinned=no
starred=no
chat_pinned=no
archived=no
unread=no
sent=no
marker_id=""
privacy=skipped mute=skipped unmute=skipped pin=skipped unpin=skipped star=skipped unstar=skipped
chatpin=skipped chatunpin=skipped archive=skipped unarchive=skipped markunread=skipped markread=skipped
forme=skipped

# Each flag is set before its write: a write cut by the timeout or a Ctrl-C may still reach WhatsApp. Exit 2 is a
# refusal before anything is sent, so it clears the flag again.
leftover() {
  rm -f "$errs"
  [ "$muted" = no ] || echo "your own chat may still be muted (for 1 h at most) — unmute it from the phone" >&2
  [ "$pinned" = no ] ||
    echo "the marker \"$marker\" may still be pinned in your own chat (for 24 h at most) — unpin it on the phone" >&2
  [ "$starred" = no ] || echo "the marker \"$marker\" may still be starred — unstar it on the phone" >&2
  [ "$chat_pinned" = no ] || echo "your own chat may still be pinned in the chat list — unpin it on the phone" >&2
  [ "$archived" = no ] || echo "your own chat may still be in Archived — unarchive it on the phone" >&2
  [ "$unread" = no ] || echo "your own chat may still be marked unread — open it on the phone" >&2
  [ "$sent" = no ] || echo "the marker \"$marker\" may still be in your own chat — delete it from the phone" >&2
}
trap leftover EXIT
on_signals

has() {
  printf '%s\n' "$paths" | grep -qx -- "$1"
}

# One wa call: its stdout in $out, its exit code in $rc. Its stderr stays in $errs and is never printed whole,
# since a refusal can quote the chat. Not wa_json: that keeps only the error code, and not_built reads the refusal.
attempt() {
  out=$("$wa" "$@" --json --no-input 2>"$errs") && rc=0 || rc=$?
}

# The error's code ("validation_error", "settings.keys-missing"), the one part of a refusal that is safe to print.
error_code() {
  head -n 1 -- "$errs" | json 'd.error.code' 2>/dev/null
}

report() {
  if [ "$rc" = 0 ]; then
    echo "$1: exit 0"
  else
    echo "$1: exit $rc, error ${2:-$(error_code)}"
  fi
}

# A command listed but refused before anything is sent: cli-core's refusal of a method wa lacks, or wa's own of a
# delete that is not for everyone.
not_built() {
  [ "$rc" = 2 ] && grep -q -e "this messenger cannot" -e "deletes only for everyone so far" "$errs"
}

# Asks until the answer is y or n; prints yes or no.
phone() {
  while :; do
    printf '%s [y/n] ' "$1" >&2
    read -r reply || exit 130
    case "$reply" in
      y | Y | yes) echo yes && return ;;
      n | N | no) echo no && return ;;
    esac
  done
}

cat <<EOF

Plan, on profile $profile, in your own chat only:
  1. wa account privacy show: read only; you compare it with the phone's Settings > Privacy
  2. wa chats mute --until 1h, then wa chats unmute
  3. wa messages send: the marker "$marker"; wa messages pin --expire-time 24h on it, then wa messages unpin
  4. wa messages star on the marker, then wa messages unstar (W7)
  5. wa chats pin on your own chat, then wa chats unpin
  6. wa chats archive on your own chat, then wa chats unarchive
  7. wa chats mark-unread on your own chat, then wa chats mark-read
  8. wa messages delete, for you only (no --for-everyone): the marker goes from your devices
After each step it asks what the phone shows. A step this build has no command for is skipped.
EOF

echo
echo "Step 1: account privacy show (reads, changes nothing)"
if has "account privacy show"; then
  attempt "$profile" account privacy show --timeout 60s
  report "privacy show"
  if [ "$rc" = 0 ]; then
    printf '%s' "$out" | json 'Object.entries(d.item).map(([name, value]) => `  ${name}: ${value}`).join("\n")'
    echo "  (a setting left out is one WhatsApp keeps with exceptions, which wa does not name)"
    echo "  on the phone: calls = Calls > Silence unknown callers (contacts when on); chat_invites = Groups;"
    echo "  hide_online = Last seen and online set to Nobody and Same as last seen"
    privacy=$(phone "Do these match the phone's Settings > Privacy?")
  else
    privacy=failed
  fi
else
  echo "not built in this checkout yet"
fi

echo
echo "Step 2: chats mute and unmute"
if has "chats mute" && has "chats unmute"; then
  confirm "Step 2 mutes your own chat for 1 hour."
  muted=yes
  attempt "$profile" chats mute "$own" --until 1h --yes --timeout 60s
  report "chats mute"
  if [ "$rc" = 0 ]; then
    mute=$(phone "Does the phone show your own chat muted (the crossed-out speaker)?")
    confirm "Next it unmutes your own chat."
    attempt "$profile" chats unmute "$own" --yes --timeout 60s
    report "chats unmute"
    if [ "$rc" = 0 ]; then
      muted=no
      unmute=$(phone "Does the phone show your own chat unmuted again?")
    else
      unmute=failed
    fi
  else
    mute=failed
    [ "$rc" != 2 ] || muted=no
  fi
else
  echo "not built in this checkout yet"
fi

echo
echo "Step 3: a marker message, pinned for 24 hours and unpinned"
confirm "Step 3 sends the marker \"$marker\" to your own chat."
sent=yes
attempt "$profile" messages send "$own" "$marker" --yes --timeout 60s
report "messages send"
[ "$rc" != 2 ] || sent=no
[ "$rc" = 0 ] || die "the send failed"
marker_id=$(printf '%s' "$out" | json 'd.item.message.id') || marker_id=""
[ -n "$marker_id" ] || die "messages send gave no message id"

# The shortest pin WhatsApp offers, so a pin the script could not undo ends by itself within a day.
if has "messages pin --expire-time" && has "messages unpin"; then
  confirm "Next it pins the marker for 24 hours, telling the chat (your own chat: only you)."
  pinned=yes
  attempt "$profile" messages pin "$own" "$marker_id" --expire-time 24h --yes --timeout 60s
  if not_built; then
    pinned=no
    echo "messages pin: not built in this checkout yet"
  else
    report "messages pin"
    if [ "$rc" = 0 ]; then
      pin=$(phone "Does the phone show the marker pinned at the top of your own chat?")
      confirm "Next it unpins the marker."
      attempt "$profile" messages unpin "$own" "$marker_id" --yes --timeout 60s
      report "messages unpin"
      if [ "$rc" = 0 ]; then
        pinned=no
        unpin=$(phone "Is the pin gone from the top of your own chat?")
      else
        unpin=failed
      fi
    else
      pin=failed
      [ "$rc" != 2 ] || pinned=no
    fi
  fi
else
  echo "not built in this checkout yet"
fi

echo
echo "Step 4: star and unstar the marker (W7)"
if has "messages star" && has "messages unstar"; then
  confirm "Step 4 stars the marker; only you see the star."
  starred=yes
  attempt "$profile" messages star "$own" "$marker_id" --yes --timeout 60s
  report "messages star"
  if [ "$rc" = 0 ]; then
    star=$(phone "Does the phone show the star on the marker?")
    confirm "Next it takes the star off the marker."
    attempt "$profile" messages unstar "$own" "$marker_id" --yes --timeout 60s
    report "messages unstar"
    if [ "$rc" = 0 ]; then
      starred=no
      unstar=$(phone "Is the star gone from the marker?")
    else
      unstar=failed
    fi
  else
    star=failed
    [ "$rc" != 2 ] || starred=no
  fi
else
  echo "not built in this checkout yet"
fi

# Before the archive: whatsmeow's archive patch also unpins the chat, which would hide what the unpin does.
echo
echo "Step 5: chats pin and unpin"
if has "chats pin" && has "chats unpin"; then
  confirm "Step 5 pins your own chat at the top of your chat list; nobody is told."
  chat_pinned=yes
  attempt "$profile" chats pin "$own" --yes --timeout 60s
  report "chats pin"
  if [ "$rc" = 0 ]; then
    chatpin=$(phone "Is your own chat at the top of the phone's chat list, with the pin icon?")
    confirm "Next it unpins your own chat."
    attempt "$profile" chats unpin "$own" --yes --timeout 60s
    report "chats unpin"
    if [ "$rc" = 0 ]; then
      chat_pinned=no
      chatunpin=$(phone "Is the pin icon gone from your own chat?")
    else
      chatunpin=failed
    fi
  else
    chatpin=failed
    [ "$rc" != 2 ] || chat_pinned=no
  fi
else
  echo "not built in this checkout yet"
fi

echo
echo "Step 6: chats archive and unarchive"
if has "chats archive" && has "chats unarchive"; then
  confirm "Step 6 moves your own chat into Archived; nobody is told."
  archived=yes
  attempt "$profile" chats archive "$own" --yes --timeout 60s
  report "chats archive"
  if [ "$rc" = 0 ]; then
    archive=$(phone "Is your own chat in Archived on the phone, and gone from the chat list?")
    confirm "Next it brings your own chat back from Archived."
    attempt "$profile" chats unarchive "$own" --yes --timeout 60s
    report "chats unarchive"
    if [ "$rc" = 0 ]; then
      archived=no
      unarchive=$(phone "Is your own chat back in the chat list, out of Archived?")
    else
      unarchive=failed
    fi
  else
    archive=failed
    [ "$rc" != 2 ] || archived=no
  fi
else
  echo "not built in this checkout yet"
fi

echo
echo "Step 7: chats mark-unread, then mark-read"
if has "chats mark-unread"; then
  confirm "Step 7 marks your own chat unread on your devices; nobody is told."
  unread=yes
  attempt "$profile" chats mark-unread "$own" --yes --timeout 60s
  report "chats mark-unread"
  if [ "$rc" = 0 ]; then
    markunread=$(phone "Does the phone show the unread dot on your own chat?")
    confirm "Next it runs chats mark-read on your own chat; it has no message from someone else, so nothing is sent."
    attempt "$profile" chats mark-read "$own" --yes --timeout 60s
    report "chats mark-read"
    if [ "$rc" = 0 ]; then
      markread=$(phone "Is the unread dot gone from your own chat?")
      # A no leaves the mark on the phone, for the owner to clear.
      [ "$markread" = no ] || unread=no
    else
      markread=failed
    fi
  else
    markunread=failed
    [ "$rc" != 2 ] || unread=no
  fi
else
  echo "not built in this checkout yet"
fi

echo
echo "Step 8: delete the marker for you only (W6)"
confirm "Step 8 deletes the marker for you only: it goes from your devices, not from the chat."
attempt "$profile" messages delete "$own" "$marker_id" --allow-dangerous --yes --timeout 60s
if not_built; then
  echo "messages delete for you only: not built in this checkout yet"
  confirm "So it deletes the marker for everyone instead, to leave your own chat as it was."
  attempt "$profile" messages delete "$own" "$marker_id" --for-everyone --allow-dangerous --yes --timeout 60s
  report "messages delete --for-everyone"
  [ "$rc" != 0 ] || sent=no
else
  report "messages delete"
  if [ "$rc" = 0 ]; then
    sent=no
    forme=$(phone "Is the marker gone from your own chat on the phone?")
  else
    forme=failed
  fi
fi

cat <<EOF

Step                     Phone    BACKLOG item 5 line it settles
1 privacy show           $(printf '%-8s' "$privacy") "Live checks of account privacy": the show half, and what calladd known is
2 chats mute             $(printf '%-8s' "$mute") "Live checks of chats mute": a one-to-one chat addressed by its LID
2 chats unmute           $(printf '%-8s' "$unmute") the same line, the unmute
3 messages pin 24h       $(printf '%-8s' "$pin") "Message pins": a pin in the own chat (a group stays open)
3 messages unpin         $(printf '%-8s' "$unpin") the same line, the unpin in the own chat
4 messages star          $(printf '%-8s' "$star") "Live check of starring": the owner's own message (W7)
4 messages unstar        $(printf '%-8s' "$unstar") the same line, the unstar
5 chats pin              $(printf '%-8s' "$chatpin") "Live checks of chats archive, ... mark-unread": the pin, by LID
5 chats unpin            $(printf '%-8s' "$chatunpin") the same line, the unpin
6 chats archive          $(printf '%-8s' "$archive") the same line, the archive
6 chats unarchive        $(printf '%-8s' "$unarchive") the same line, the unarchive
7 chats mark-unread      $(printf '%-8s' "$markunread") the same line, the mark-unread
7 chats mark-read        $(printf '%-8s' "$markread") "chats mark-read after a mark-unread": the own chat, no receipt
8 delete for you only    $(printf '%-8s' "$forme") "Live check of delete for the owner alone": the own message (W6)

A yes settles that part of the line; no or failed is a bug to file; skipped waits for that feature's build.
For 7 chats mark-read, no is the expected answer: without the read patch, wa cannot undo a mark-unread in the own
chat. Whether a receipt in another chat clears it stays open.
EOF
