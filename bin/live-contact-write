#!/usr/bin/env sh
# Live check for WA-1, contact writes: names one person in the address book of a SPARE WhatsApp account through the
# engine's `saveContact`, reads the name back from what WhatsApp returned, then asks the owner at the spare phone.
# The person must not be saved in the spare phone's address book: the phone shows the address-book name for anyone
# saved there, and this write (saveOnPrimaryAddressbook false) leaves the address book alone. The 2026-11-08 run used
# a saved person, and its "phone shows the new name: no" could not tell a failed write from that.
# The owner runs it from a terminal; an agent never does. Never on the owner's own account: a bad contact change can
# stall contact names on every device of the account until a full re-sync.
#
#   bin/live-contact-write <spare-profile>
#
# `contacts add` and `contacts rename` stay refused in wa until this passes, so the script calls the engine directly,
# as `wa` would. It sends no message to anyone. The phone number is typed at a prompt and never printed; the result
# block holds yes/no and error codes only. The exit code is 0 only on a pass.
set -eu

# shellcheck source-path=SCRIPTDIR source=lib/live.sh
. "$(dirname -- "$0")/lib/live.sh"

profile=${1:-}
need_profile "$profile"
[ $# -le 1 ] || die "usage: $(basename -- "$0") <spare-profile>"
! lock_held "$profile" ||
  die "something holds profile $profile's device, serve perhaps — stop it first: this script connects the device itself"

# A word typed at a prompt cannot tell a spare from the main account: the 2026-11-08 run wrote to the main one. So the
# profile's account must differ from every other profile's (compared without printing either), and the engine must
# confirm the spare phone's number before the write.
accounts="$main/.wa/state/accounts"
[ -f "$accounts/$profile.json" ] || die "profile $profile has no recorded account — link it again with bin/live-fresh-link"
for other in "$accounts"/*.json; do
  [ "$other" = "$accounts/$profile.json" ] && continue
  ! cmp -s -- "$other" "$accounts/$profile.json" ||
    die "profile $profile is linked to the same WhatsApp account as profile $(basename -- "$other" .json), so it is not a spare; nothing written"
done

cat <<EOF

This writes ONE contact name in the address book of the WhatsApp account linked as profile $profile:
  1. you name one person the spare account has a chat with but who is NOT saved in the spare phone's Contacts
     app: their chat shows a phone number or a ~name. The phone shows the Contacts app name for anyone saved there,
     so a saved person cannot show this check's name
  2. wa gives them the name "WA check <number>" in that account's WhatsApp contacts; the phone's Contacts app is
     left alone and nothing is sent to them
  3. you close WhatsApp on the spare phone fully, open it again and answer three questions
  4. you remove the contact in WhatsApp on the spare phone
Use a SPARE account only, never your own: a bad contact change can stall contact names on all its devices.
EOF
printf '\nThe SPARE phone'"'"'s own number, with the country code (checked against profile %s, not shown): ' "$profile"
read -r spare_number || exit 130
spare=$(printf '%s' "$spare_number" | tr -cd '0-9')
[ "${#spare}" -ge 8 ] || die "that is not a phone number with its country code"
printf 'Phone number of the person, with the country code (digits only are kept, nothing is shown): '
read -r number || exit 130
digits=$(printf '%s' "$number" | tr -cd '0-9')
[ "${#digits}" -ge 8 ] || die "that is not a phone number with its country code"
[ "$digits" != "$spare" ] || die "that is the spare's own number; the person must be someone else — nothing written"
saved=$(phone "Is that person saved in the spare phone's Contacts app (their chat shows a name without ~)?")
[ "$saved" = no ] || die "pick a person not in the phone's Contacts app: it shows that app's name for them; nothing written"

run=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
marker="WA check $run"
confirm "Step 2 names that person \"$marker\" in the spare account's contacts."
on_signals

# One engine run: the write, then the read-back from the contact store whatsmeow fills from the patch WhatsApp
# returned. Only fixed words and error codes are printed.
set +e
engine=$(WA_CONFIG_DIR="$main/.wa/config" WA_STATE_DIR="$main/.wa/state" WA_CACHE_DIR="$main/.wa/cache" \
  node --input-type=module -e '
    const [main, profile, digits, marker, spare] = process.argv.slice(1)
    const { startGoEngine } = await import(`${main}/dist/engine/go-engine.js`)
    const { privateStore } = await import(`${main}/dist/paths.js`)
    const failed = (step, error) => {
      console.log(`${step}: ${error?.code ?? "failed"}${error?.reason ? ` (${error.reason})` : ""}`)
      process.exitCode = 1
    }
    const engine = await startGoEngine({ storePath: privateStore(profile), holder: "live-contact-write" }).catch(
      (error) => failed("engine", error),
    )
    if (engine) {
      try {
        const own =
          engine.self() === null
            ? failed("own id", { code: "missing" })
            : await engine.ownNumber(spare).catch((error) => failed("own number", error))
        if (own) {
          console.log(`ends ${own.ends}`)
          console.log(`spare number matches: ${own.matches ? "yes" : "no"}`)
          if (!own.matches) process.exitCode = 1
        }
        if (own?.matches) {
          const written = await engine.saveContact(`${digits}@s.whatsapp.net`, marker).then(
            () => true,
            (error) => failed("write", error),
          )
          if (written) {
            console.log("write: ok")
            const back = (await engine.contacts()).some((contact) => contact.name === marker)
            console.log(`read back: ${back ? "yes" : "no"}`)
          }
        }
      } finally {
        await engine.close()
      }
    }
  ' "$main" "$profile" "$digits" "$marker" "$spare" 2>/dev/null)
set -e
ends=$(printf '%s\n' "$engine" | sed -n 's/^ends //p')
engine=$(printf '%s\n' "$engine" | grep -v '^ends ' || true)
[ -z "$ends" ] || echo "Profile $profile is linked to the WhatsApp account whose number ends in $ends."
printf '%s\n' "$engine" | grep -qx "spare number matches: no" &&
  echo "That is not the spare number you typed, so nothing was written. Link the spare with bin/live-fresh-link, scanning with the spare phone."
[ -n "$engine" ] || engine="engine: did not start (is $main built, engine included?)"
printf '%s\n' "$engine"

# Once the write went out, the phone is asked even when the read-back missed: the name may have changed anyway.
shown=skipped
info=skipped
intact=skipped
self_name=skipped
if printf '%s\n' "$engine" | grep -qx "write: ok"; then
  echo
  echo "Step 3: on the spare phone, close WhatsApp fully (swipe it away from the recent apps), wait a minute, open it."
  shown=$(phone "Does that person's chat in the chat list now show as \"$marker\"?")
  info=$(phone "Tap the chat's name at the top: does their contact info show \"$marker\"?")
  intact=$(phone "Do your other contacts on the spare phone still show their usual names?")
  self_name=$(phone "Did the profile name of any of your own accounts change (Settings, your name at the top; the chat with yourself)?")
fi

verdict=FAIL
printf '%s\n' "$engine" | grep -qx "read back: yes" && [ "$shown" = yes ] && [ "$intact" = yes ] && [ "$self_name" = no ] &&
  verdict=PASS
cat <<EOF

── result ──
$engine
chat list shows the name   $shown
contact info shows it      $info
other names unchanged      $intact
own profile name changed   $self_name
WA-1: $verdict — one WhatsApp contact name written from a linked device for a person not in the phone's address book
(a pass needs write ok, read back yes, the chat list showing the name, the other names and the own name unchanged)

Paste only this block. Remove the contact in WhatsApp on the spare phone.
EOF
[ "$verdict" = PASS ]
