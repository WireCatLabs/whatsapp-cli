#!/usr/bin/env sh
# The owner's sign-off on a release report, in one step: the report is written before the release pull request is
# squash-merged, so its Commit line cannot name the merge commit until then. This pulls main, checks the merged tree
# is the one the report reviewed, writes the commit, adds today's Signed off line and pushes docs_ai. Then run
# `bin/release --local`.
#
#   bin/sign-release
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
git -C docs_ai rev-parse --git-dir >/dev/null 2>&1 ||
  { echo "no docs_ai/ — link the cli-private checkout as docs_ai/" >&2; exit 1; }

[ "$(git branch --show-current)" = main ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
git fetch -q origin main
git merge -q --ff-only origin/main

version=$(node -p 'require("./package.json").version')
report="docs_ai/releases/whatsapp-cli/$version.md"
[ -f "$report" ] || { echo "no release report $report — run the release skill first" >&2; exit 1; }
grep -q '^Signed off:' "$report" && { echo "$report is already signed" >&2; exit 1; }

head=$(git rev-parse HEAD)
tree=$(git rev-parse 'HEAD^{tree}')
# The report names the tree it reviewed; a merge that changed anything else voids its evidence.
expected=$(sed -n 's/.*tree must be \([0-9a-f]\{40\}\).*/\1/p' "$report" | head -n 1)
if [ -n "$expected" ] && [ "$expected" != "$tree" ]; then
  echo "main's tree is $tree, but $report reviewed $expected — main moved; rerun the release skill" >&2
  exit 1
fi

git -C docs_ai pull -q --rebase
tmp=$(mktemp)
awk -v head="$head" -v today="$(date +%Y-%m-%d)" '
  /^Commit:/ && !done { print "Commit: " head; print "Signed off: " today; done = 1; next }
  { print }
' "$report" >"$tmp"
mv "$tmp" "$report"
git -C docs_ai add "releases/whatsapp-cli/$version.md"
git -C docs_ai commit -q -m "docs(release): sign off whatsapp-cli $version at ${head%"${head#???????}"}"
git -C docs_ai push -q
echo "signed $report for $head — now run: bin/release --local"
