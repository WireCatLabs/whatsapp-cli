#!/usr/bin/env sh
# Publishes the version in package.json and tags it. Run on a clean `main`. When npm already has that
# version, or a higher one, it raises it to the next free one through a pull request and publishes that. Nothing is
# published until `pnpm release:check` passes. The owner runs it, never an agent: the judgement half is the release
# skill (docs/dev/skills/release/SKILL.md), and its report, docs_ai/releases/whatsapp-cli/<version>.md, must name
# this commit and carry the owner's sign-off (WC-REL-10). docs_ai/ is a clone of the private repository
# WireCatLabs/cli-private; a fork without it passes its own signed report. An Unreleased section left above the
# dated, unpublished version is folded into it the same way, and the report is carried with a fold or a raise.
#
#   bin/release                   # publishes from GitHub Actions (.github/workflows/release.yml)
#   bin/release --local           # publishes from this machine: NPM_TOKEN if exported, else the keyring
#   bin/release --report <path>   # checks that signed report instead of docs_ai/releases/whatsapp-cli/<version>.md
#
# The npm token is never printed and never written to a file — not on success, not in an error.
set -eu

# Keep the caller's token out of checks and lifecycle scripts.
publish_token=${NPM_TOKEN:-}
unset NPM_TOKEN

usage() { echo "usage: bin/release [--local] [--report <path>]" >&2; exit 2; }
mode=ci
custom=""
pending=""
for arg; do
  if [ -n "$pending" ]; then custom=$arg; pending=""; continue; fi
  case "$arg" in
    --local) mode=local ;;
    --report) pending=1 ;;
    *) usage ;;
  esac
done
[ -z "$pending" ] || usage
case "$custom" in
  "" | /*) ;;
  *) custom="$PWD/$custom" ;;
esac
# The re-exec below runs from the repository root, where a relative --report would point elsewhere.
set --
[ "$mode" = ci ] || set -- --local
[ -z "$custom" ] || set -- "$@" --report "$custom"

cd "$(dirname "$0")/.."
self=$(git hash-object bin/release)
# The fold and land() fast-forward main, and sh reads this file as it goes: a newer bin/release would run half old,
# half new. Run the new one from the start instead: the second run finds the fold and the raise already on main, and
# the report carried to them.
rerun_if_changed() {
  [ "$(git hash-object bin/release)" != "$self" ] || return 0
  [ -z "${WIRECAT_RELEASE_RERUN:-}" ] || { echo "bin/release changed again while releasing — run it again" >&2; exit 1; }
  echo "bin/release changed on main — running the new one"
  export WIRECAT_RELEASE_RERUN=1
  NPM_TOKEN="$publish_token" exec ./bin/release "$@"
}
package=@wirecat/whatsapp-cli

# With the tags: the check below that refuses to release one commit twice reads them.
git fetch -q --tags origin
[ "$(git branch --show-current)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
before=$(git rev-parse HEAD)
git merge -q --ff-only origin/main
# The shell keeps running the file it read before the merge; max-cli published with a stale copy.
[ "$(git rev-parse HEAD)" = "$before" ] || NPM_TOKEN="$publish_token" exec "$0" "$@"
# The workflow publishes origin/main, so a local commit not pushed yet would silently not ship.
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main is ahead of origin/main — push first" >&2; exit 1; }
# One release at a time on this machine, across every package: two sessions published at once on 2026-10-08.
. ./config/wirecat/release-lock.sh
wirecat_release_lock
version=$(node -p 'require("./package.json").version')
# `npm view` rather than the registry document, which a CDN serves stale for minutes.
published() {
  npm view "$package@$version" version --prefer-online >/dev/null 2>&1
}

# The judgement half of the release — changelog, docs, the live scenarios on the owner's account — is the release
# skill's, and its report is the only record that it ran for this exact commit.
if [ -n "$custom" ]; then
  report=$custom
elif [ -d docs_ai ]; then
  report="docs_ai/releases/whatsapp-cli/$version.md"
else
  echo "no docs_ai/ — release reports live in the private repository WireCatLabs/cli-private, cloned into" \
    "docs_ai/, as releases/whatsapp-cli/$version.md. A fork passes its own signed report: bin/release --report <path>" >&2
  exit 1
fi
[ -f "$report" ] || { echo "no release report $report — run the release skill first" >&2; exit 1; }
grep -qx "Commit: $(git rev-parse HEAD)" "$report" || { echo "$report is for another commit than HEAD" >&2; exit 1; }
# A date, not the template's placeholder, so a report copied from the template does not pass as signed.
grep -Eq '^Signed off: [0-9]{4}-[0-9]{2}-[0-9]{2}' "$report" || { echo "$report is not signed off by the owner" >&2; exit 1; }

# Released already: the renumbering below would relabel that version's notes and publish the same code again.
if [ -n "$(git tag -l "v$version")" ] && [ "$(git rev-list -n 1 "v$version")" = "$(git rev-parse HEAD)" ]; then
  echo "v$version is this very commit — nothing new to release" >&2
  exit 1
fi

# The report stays the owner's: it is checked above for the commit they signed, and carried to the new HEAD only
# when the commits since change nothing but the number and the changelog.
committed() {
  [ -n "$custom" ] || git -C docs_ai ls-files --error-unmatch "releases/whatsapp-cli/$version.md" >/dev/null 2>&1 ||
    { echo "$report is not committed in docs_ai — commit it first" >&2; exit 1; }
  signed=$(git rev-parse HEAD)
}
carry() {
  to=$1 note=$2 subject=$3
  extra=$(git diff --name-only "$signed" HEAD | grep -vx -e package.json -e src/version.ts -e CHANGELOG.md || true)
  [ -z "$extra" ] || { echo "main changed more than the number since $report was signed: $extra" >&2; exit 1; }
  if [ -z "$custom" ] && [ "$to" != "$version" ]; then
    git -C docs_ai mv "releases/whatsapp-cli/$version.md" "releases/whatsapp-cli/$to.md"
    report="docs_ai/releases/whatsapp-cli/$to.md"
  fi
  # shellcheck disable=SC2016 # The templates are JavaScript, not shell interpolation.
  node -e 'const fs = require("fs"); const [file, o, n, signed, head, note] = process.argv.slice(1)
    const text = fs.readFileSync(file, "utf8").replace(`# ${o}\n`, `# ${n}\n`)
    const carried = text.replace(`Commit: ${signed}`, `Commit: ${head}`).trimEnd()
    fs.writeFileSync(file, `${carried}\n\n${note} Signed for ${signed}; ${head} changes only the number and the changelog.\n`)' \
    "$report" "$version" "$to" "$signed" "$(git rev-parse HEAD)" "$note"
  if [ -z "$custom" ]; then
    git -C docs_ai commit -q -m "$subject" -- "releases/whatsapp-cli/$version.md" "releases/whatsapp-cli/$to.md"
    git -C docs_ai push -q || echo "docs_ai: the carried report is committed but not pushed — push docs_ai" >&2
  else
    echo "$report now reports $to at $(git rev-parse HEAD) — commit it yourself" >&2
  fi
}

# main takes changes only through a pull request (the repository's ruleset), as in max-cli.
land() {
  branch=$1 title=$2 body=$3
  git switch -q -c "$branch"
  git commit -q -am "$title" -m "$body"
  git push -q -u origin "$branch"
  git switch -q main
  pr=$(gh pr create --base main --head "$branch" --title "$title" --body "$body")
  # Checks register a few seconds after the pull request; --watch with none exits at once.
  for _ in $(seq 30); do
    [ "$(gh pr checks "$pr" --json name --jq length 2>/dev/null || echo 0)" -gt 0 ] && break
    sleep 2
  done
  gh pr checks "$pr" --watch --fail-fast >/dev/null ||
    { echo "checks failed on $pr — nothing is published" >&2; exit 1; }
  gh pr merge "$pr" --squash --delete-branch --subject "$title (#${pr##*/})"
  git fetch -q origin
  git merge -q --ff-only origin/main
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] ||
    { echo "main is not origin/main after $pr" >&2; exit 1; }
}

# A session that merges after the version was dated, but before it was published, adds Unreleased above it.
# --land folds on a fresh main through its own pull request, and folds again once if main moves under it.
# cli-dev is pinned rather than taken from the dependencies: cli-core accepts only an older cli-base.
folded=""
if ! published; then
  signed_at=$(git rev-parse HEAD)
  folded=$(npx -y -p @wirecat/cli-base@0.36.0 cli-dev changelog fold --land --version "$version")
fi
if [ -n "$folded" ]; then
  echo "$folded"
  committed
  signed=$signed_at
  carry "$version" "bin/release folded Unreleased into $version." \
    "docs(releases): whatsapp-cli $version carried to the folded changelog by bin/release"
fi
rerun_if_changed "$@"

# Two sessions preparing the same number is normal; the second takes the next free one (2026-09-29).
latest=$(npm view "$package" version --prefer-online 2>/dev/null || true)
versions=$(npm view "$package" versions --json --prefer-online 2>/dev/null) || versions=""
next=$(node scripts/next-version.mjs "$version" "$latest" "$versions")
if [ "$next" != "$version" ]; then
  taken=""
  if published; then taken=1; why="$version is already on npm"; else why="$version is not above npm's latest $latest"; fi
  echo "$why — publishing $next instead"
  committed
  # A version npm already has keeps its changelog section; the unreleased one becomes the new version.
  # shellcheck disable=SC2016 # The templates are JavaScript, not shell interpolation.
  node -e 'const fs = require("fs"); const [o, n, taken] = process.argv.slice(1)
    const swap = (file, from, to) => fs.writeFileSync(file, fs.readFileSync(file, "utf8").replace(from, to))
    swap("package.json", `"version": "${o}"`, `"version": "${n}"`)
    swap("src/version.ts", `VERSION = "${o}"`, `VERSION = "${n}"`)
    const today = new Date().toLocaleDateString("en-GB").replaceAll("/", ".")
    if (taken) swap("CHANGELOG.md", "\n## Unreleased\n", `\n## ${n} — ${today}\n`)
    else swap("CHANGELOG.md", `\n## ${o} — `, `\n## ${n} — `)' "$version" "$next" "$taken"
  node scripts/engine-packages.mjs sync
  body="bin/release: $why. Only the number changes: package.json (and its engine packages), src/version.ts, the CHANGELOG heading."
  land "release/$next" "chore(release): $next" "$body"
  carry "$next" "Renumbered by bin/release: $version → $next ($why)." \
    "docs(releases): whatsapp-cli $version → $next, renumbered by bin/release"
  rerun_if_changed "$@"
  version=$next
fi
if published; then
  echo "$version is already on npm — raise the version first" >&2
  exit 1
fi

# The fold fast-forwards main even when it has nothing to fold, so HEAD can be a commit nobody signed.
grep -qx "Commit: $(git rev-parse HEAD)" "$report" ||
  { echo "main moved past the commit $report was signed for — sign the new HEAD and run again" >&2; exit 1; }

echo "== checks for $version =="
pnpm install --frozen-lockfile
pnpm release:check

if [ "$mode" = ci ]; then
  last_run() {
    gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
      --json databaseId --jq '.[0].databaseId // ""'
  }
  previous=$(last_run)
  echo "== starting the release workflow for $version =="
  gh workflow run release.yml --ref main -f commit="$(git rev-parse HEAD)"
  run=""
  for _ in $(seq 30); do
    run=$(last_run)
    [ -n "$run" ] && [ "$run" != "$previous" ] && break
    run=""
    sleep 2
  done
  [ -n "$run" ] || { echo "the release workflow did not start within a minute — see gh run list --workflow release.yml" >&2; exit 1; }
  gh run watch "$run" --exit-status
  git fetch -q --tags origin
  echo "published $package@$version"
  exit 0
fi

if [ -z "$publish_token" ]; then
  publish_token=$(secret-tool lookup service npm account leemour 2>/dev/null) || {
    echo "no npm token: export NPM_TOKEN, or store one with: secret-tool store --label=npm service npm account leemour" >&2
    exit 1
  }
fi
[ -n "$publish_token" ] || { echo "the npm token is empty" >&2; exit 1; }

# A config of our own that names the variable, not the value: the token stays in the environment,
# and the user's ~/.npmrc is neither read nor changed.
config=$(mktemp)
trap 'rm -f "$config"' EXIT
# shellcheck disable=SC2016 # npm resolves the variable only in the publish process.
printf '//registry.npmjs.org/:_authToken=${NPM_TOKEN}\n' > "$config"

echo "== local validation for $version =="
pnpm test:coverage
pnpm engine:test
pnpm contracts:check
pnpm run --if-present contracts:upgrade
pnpm security:no-leak
pnpm secrets:scan
pnpm audit --prod --audit-level critical
(cd engine && go run golang.org/x/vuln/cmd/govulncheck@latest ./...)
node scripts/engine-packages.mjs build

echo "== publishing the engine packages of $version =="
for dir in packages/engine-*; do
  name=$(node -p 'require(process.argv[1]).name' "./$dir/package.json")
  if npm view "$name@$version" version --prefer-online >/dev/null 2>&1; then
    echo "$name@$version is already on npm"
    continue
  fi
  NPM_TOKEN="$publish_token" npm publish "./$dir" --access public --ignore-scripts --userconfig "$config"
done

echo "== publishing $version =="
NPM_TOKEN="$publish_token" npm publish --access public --ignore-scripts --userconfig "$config"

# Either answer counts, and as long as release.yml waits: each of the two has been seen stale for minutes on its own.
echo "== waiting for npm to show $version (up to fifteen minutes) =="
seen=""
for _ in $(seq 90); do
  if published || curl -sfo /dev/null "https://registry.npmjs.org/@wirecat%2fwhatsapp-cli/$version"; then seen=1; break; fi
  sleep 10
done
[ -n "$seen" ] || {
  echo "npm does not show $version after fifteen minutes — not tagging. Once it does, on $(git rev-parse HEAD):" >&2
  echo "  git tag -a v$version -m $version && git push origin v$version" >&2
  echo "  gh release create v$version --title $version, with the $version section of CHANGELOG.md as its notes" >&2
  exit 1
}

# The same tag and GitHub release that release.yml's tag job makes (WC-REL-13).
echo "== tag v$version and its GitHub release =="
git tag -a "v$version" -m "$version"
git push -q origin "v$version"
awk -v v="$version" '$0 ~ "^## "v" " {on=1; next} /^## / && on {exit} on' CHANGELOG.md |
  gh release create "v$version" --title "$version" --notes-file - || {
  echo "v$version is tagged, but its GitHub release is not: gh release create v$version --title $version," \
    "with the $version section of CHANGELOG.md as its notes" >&2
  exit 1
}
echo "published $package@$version"
