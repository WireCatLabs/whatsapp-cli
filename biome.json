{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./config/wirecat/biome.base.json"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/pnpm-lock.yaml",
      "!**/pnpm-workspace.yaml",
      "!.worktrees",
      "!config/wirecat",
      "!lint/baseline"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/adapter/**",
        "!src/engine/**",
        "!src/testing/**",
        "!src/messenger.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/engine/**",
                      "./engine/*",
                      "../engine/*",
                      "**/adapter/**",
                      "./adapter/*",
                      "../adapter/*"
                    ],
                    "message": "above the adapter, code speaks the domain model through cli-core's port; only the composition root, src/messenger.ts, reaches the engine and the adapter"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/adapter/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/commands/**",
                      "../commands/*",
                      "**/program.js",
                      "../program.js",
                      "**/messenger.js",
                      "../messenger.js",
                      "@wirecat/cli-core/store",
                      "@wirecat/cli-core/store/*"
                    ],
                    "message": "the adapter maps the engine onto the shared messenger port; commands, the program, the messenger and the shared store are above it"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/engine/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/adapter/**",
                      "../adapter/*",
                      "**/commands/**",
                      "../commands/*",
                      "**/program.js",
                      "../program.js",
                      "**/messenger.js",
                      "../messenger.js",
                      "@wirecat/cli-core",
                      "@wirecat/cli-core/*"
                    ],
                    "message": "the engine speaks WhatsApp's terms only; no cli-core domain type and nothing above the adapter (docs/dev/ARCHITECTURE.md)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
